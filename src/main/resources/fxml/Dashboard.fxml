<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.cloudbalancer.controller.DashboardController">

    <top>
        <MenuBar>
            <Menu text="File">
                <MenuItem text="Upload"   onAction="#handleUpload"/>
                <MenuItem text="Download" onAction="#handleDownload"/>
                <MenuItem text="Delete"   onAction="#handleDelete"/>
                <SeparatorMenuItem/>
                <MenuItem text="Log Out"  onAction="#handleLogout"/>
            </Menu>
            <Menu text="Admin" fx:id="adminMenu" visible="false">
                <MenuItem text="Manage Users" onAction="#handleOpenAdmin"/>
            </Menu>
            <Menu text="Help">
                <MenuItem text="About" onAction="#handleAbout"/>
            </Menu>
        </MenuBar>
    </top>

    <center>
        <VBox>
            <Label fx:id="welcomeLabel" style="-fx-font-size: 13px; -fx-padding: 6 8 4 8;"/>
            <TableView fx:id="fileTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colFilename" text="Filename"  prefWidth="280"/>
                    <TableColumn fx:id="colSize"     text="Size (B)"  prefWidth="100"/>
                    <TableColumn fx:id="colChunks"   text="Chunks"    prefWidth="80"/>
                    <TableColumn fx:id="colDate"     text="Uploaded"  prefWidth="160"/>
                </columns>
                <placeholder><Label text="No files uploaded yet."/></placeholder>
            </TableView>
            <HBox spacing="8" style="-fx-padding: 6 8 6 8;">
                <Button text="Upload"   onAction="#handleUpload"/>
                <Button text="Download" onAction="#handleDownload"/>
                <Button text="Share"    onAction="#handleShare"/>
                <Button text="Delete"   onAction="#handleDelete"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <TabPane prefHeight="180">
            <Tab text="Logs" closable="false">
                <TextArea fx:id="logArea" editable="false" wrapText="true"
                          style="-fx-font-family: monospace; -fx-font-size: 11px;"/>
            </Tab>
            <Tab text="Terminal" closable="false">
                <VBox spacing="6">
                    <padding><Insets top="6" bottom="6" left="8" right="8"/></padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="Target:"/>
                        <ChoiceBox fx:id="terminalTarget" prefWidth="160"/>
                    </HBox>
                    <TextArea fx:id="terminalOutput" editable="false" prefHeight="90"
                              style="-fx-font-family: monospace; -fx-font-size: 11px;"/>
                    <HBox spacing="8">
                        <TextField fx:id="terminalInput" promptText="Enter command..."
                                   HBox.hgrow="ALWAYS" onAction="#handleTerminalCommand"/>
                        <Button text="Run" onAction="#handleTerminalCommand"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </bottom>

</BorderPane>
